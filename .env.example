# =============================================================================
# Attune AI — Environment variables
# Copy to .env.local and set values. Never commit .env.local or real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Vapi (voice)
# -----------------------------------------------------------------------------
# Webhook verification (server). Get from Vapi dashboard.
VAPI_WEBHOOK_SECRET=
# Secret for tool endpoints (e.g. findProviders). Same value as in Vapi assistant server-side tool config.
VAPI_SERVER_SECRET=
# Optional: for future server-side Vapi API calls
# VAPI_API_KEY=

# Client-side (Vapi Web SDK). Required for voice widget.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# Optional: debug auth for findProviders / tool calls
# DEBUG_VAPI_AUTH=true

# -----------------------------------------------------------------------------
# OpenAI (chat + embeddings)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# Optional overrides
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# App URL (used in emails, callbacks, Vapi webhook base URL)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# PRODUCT_NAME=Attune AI

# -----------------------------------------------------------------------------
# RAG ingest (protects POST /api/rag/ingest)
# -----------------------------------------------------------------------------
INGEST_SECRET=

# -----------------------------------------------------------------------------
# Referrals (Google Places + email)
# -----------------------------------------------------------------------------
# Required for provider search. Enable Places API (New) + Geocoding API in Google Cloud.
GOOGLE_PLACES_API_KEY=
# Optional: separate key for Geocoding (defaults to GOOGLE_PLACES_API_KEY)
# GOOGLE_GEOCODING_API_KEY=

# Resend (referral email summary)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# -----------------------------------------------------------------------------
# RAG harvest (optional). See docs/rag-harvest.md
# -----------------------------------------------------------------------------
# BRAVE_API_KEY=
# HARVEST_USER_AGENT=AttuneRAGHarvester/1.0
# HARVEST_MAX_RESULTS=20
# HARVEST_MAX_BYTES=20971520
# HARVEST_RATE_LIMIT_MS=1000
# HARVEST_MAX_SEARCH_REQUESTS=500
# HARVEST_MAX_RESULTS=20
