# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_publishable_default_key
# Server-only: used for RAG ingest and other admin operations (bypasses RLS)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Vapi Configuration
VAPI_API_KEY=your_vapi_api_key
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret

# Vapi Web SDK (client-side only — use Public Key, never private key)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# Zocdoc Configuration
ZOCDOC_API_KEY=your_zocdoc_api_key
ZOCDOC_API_BASE_URL=https://api.zocdoc.com/v1

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@attune-ai.com

# OpenAI (RAG embeddings + chat)
OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# RAG Ingest (protects POST /api/rag/ingest and POST /api/rag/ingest-folder)
INGEST_SECRET=your_ingest_secret_token

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
PRODUCT_NAME=Attune AI
